{
  "expo": {
    "name": "EasySplit",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-removebg_360x360.png",
    "scheme": "easysplit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.huytuangiang.frontend",
      "buildNumber": "2"
    },

    "android": {
      "package": "com.easysplit",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",

      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo-removebg_360x360.png",
        "backgroundImage": "./assets/images/logo-removebg_360x360.png",
        "monochromeImage": "./assets/images/logo-removebg_360x360.png"
      },

      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-removebg_360x360.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-secure-store",
      "@react-native-firebase/app",
      "@react-native-community/datetimepicker"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf7d5f32-3b1b-438c-bc99-5247fe817084"
      }
    }
  }
}
