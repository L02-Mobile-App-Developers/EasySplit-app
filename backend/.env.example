# Server
PORT=8080
NODE_ENV=development

# Database
DATABASE_URL="postgresql://easysplit:easysplit@localhost:5432/easysplit?schema=public"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Free Tier Quotas
FREE_MAX_GROUPS=3
FREE_SMART_SETTLE_PER_MONTH=3
FREE_HISTORY_DAYS=90

# Idempotency
IDEMPOTENCY_WINDOW_HOURS=24

# Dev Auth (skip JWT in local dev)
DEV_AUTH_ENABLED=true
