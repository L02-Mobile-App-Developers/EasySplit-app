# Server
PORT=8080
NODE_ENV=staging
DEV_AUTH_ENABLED=false

# CORS
CORS_ORIGIN="https://your-staging-frontend.example.com"

# JWT
# Local development/test only. Production API auth uses Firebase ID tokens.
JWT_SECRET="replace-with-staging-only-random-secret"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Firebase Authentication + Firestore Database
# Production/staging clients send Authorization: Bearer <firebase_id_token>.
# Provide exactly one credential strategy:
# 1) GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# 2) FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"..."}'
# 3) FIREBASE_SERVICE_ACCOUNT_BASE64="base64-json"
# 4) FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_SERVICE_ACCOUNT_BASE64=""
FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# Free Tier Quotas 
FREE_MAX_GROUPS=3
FREE_SMART_SETTLE_PER_MONTH=3
FREE_HISTORY_DAYS=90

# Idempotency
IDEMPOTENCY_WINDOW_HOURS=24
IDEMPOTENCY_PROCESSING_TIMEOUT_SECONDS=30
