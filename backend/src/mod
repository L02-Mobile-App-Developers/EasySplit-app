import { prisma } from "../../lib/prisma";
import {
  NotFoundError,
  ForbiddenError,
  ValidationError,
} from "../../lib/errors";

interface ParticipantInput {
  userId: string;
  value: number;
}

interface CreateExpenseInput {
  description: string;
  amount: number;
  currency?: string;
  paidByUserId: string;
  splitMode: "equal" | "amount" | "percent" | "weight";
  participants: ParticipantInput[];
}

interface UpdateExpenseInput {
  description?: string;
  amount?: number;
  currency?: string;
  paidByUserId?: string;
  splitMode?: "equal" | "amount" | "percent" | "weight";
  participants?: ParticipantInput[];
}

// ───────────────────────────── Helpers ─────────────────────────────

async function assertMember(groupId: string, userId: string) {
  const membership = await prisma.groupMember.findUnique({
    where: { groupId_userId: { groupId, userId } },
  });
  if (!membership || !membership.isActive) {
    throw new NotFoundError("Group not found");
  }
  return membership;
}

async function assertGroupActive(groupId: string) {
  const group = await prisma.group.findUnique({ where: { id: groupId } });
  if (!group) throw new NotFoundError("Group not found");
  if (group.status !== "active") {
    throw new ForbiddenError("Group is closed");
  }
  return group;
}

async function assertCanModifyExpense(
  groupId: string,
  expenseId: string,
  userId: string,
) {
  const expense = await prisma.expense.findUnique({ where: { id: expenseId } });
  if (!expense) throw new NotFoundError("Expense not found");
  if (expense.groupId !== groupId)
    throw new NotFoundError("Expense not found in this group");
  if (expense.createdBy !== userId) {
    throw new ForbiddenError("Only the creator can modify this expense");
  }
  return expense;
}

/**
 * Validate participants for the given group and split mode.
 * Throws ValidationError if invalid.
 */
async function validateParticipants(
  groupId: string,
  paidByUserId: string,
  participants: ParticipantInput[],
  amount: number,
  splitMode: string,
) {
  // Collect all involved user ids
  const userIds = [paidByUserId, ...participants.map((p) => p.userId)];
  const uniqueUserIds = [...new Set(userIds)];

  // Verify all users are active members of the group
  const memberships = await prisma.groupMember.findMany({
    where: { groupId, userId: { in: uniqueUserIds }, isActive: true },
  });
  const memberIds = new Set(memberships.map((m) => m.userId));

  for (const uid of uniqueUserIds) {
    if (!memberIds.has(uid)) {
      throw new ValidationError(
        `User ${uid} is not an active member of this group`,
      );
    }
  }

  if (participants.length === 0) {
    throw new ValidationError("At least one participant is required");
  }

  switch (splitMode) {
    case "amount": {
      const total = participants.reduce((s, p) => s + p.value, 0);
      if (total !== amount) {
        throw new ValidationError(
          `Participant values sum (${total}) does not match amount (${amount})`,
        );
      }
      break;
    }
    case "percent": {
      const total = participants.reduce((s, p) => s + p.value, 0);
      if (total !== 100) {
        throw new ValidationError(`Percentages must sum to 100 (got ${total})`);
      }
      for (const p of participants) {
        if (p.value < 0 || p.value > 100) {
          throw new ValidationError(
            "Each percentage must be between 0 and 100",
          );
        }
      }
      break;
    }
    case "weight": {
      for (const p of participants) {
        if (p.value < 0) {
          throw new ValidationError("Weight values must be non-negative");
        }
      }
      break;
    }
    case "equal":
      // value is ignored
      break;
  }
}

/**
 * Recalculate all balances for a group from scratch.
 */
async function recalculateBalances(groupId: string) {
  const members = await prisma.groupMember.findMany({
    where: { groupId, isActive: true },
  });
  const memberIds = members.map((m) => m.userId);

  const expenses = await prisma.expense.findMany({
    where: { groupId },
    include: { participants: true },
  });

  const balanceMap = new Map<string, number>();
  for (const uid of memberIds) {
    balanceMap.set(uid, 0);
  }

  for (const expense of expenses) {
    const payerId = expense.paidByUserId;
    const expAmount = expense.amount;
    const expParticipants = expense.participants;

    if (expParticipants.length === 0) continue;

    const shares = new Map<string, number>();

    switch (expense.splitMode) {
      case "equal": {
        const share = Math.floor(expAmount / expParticipants.length);
        const remainder = expAmount - share * expParticipants.length;
        expParticipants.forEach((p, idx) => {
          shares.set(p.userId, share + (idx === 0 ? remainder : 0));
        });
        break;
      }
      case "amount": {
        expParticipants.forEach((p) => {
          shares.set(p.userId, p.value);
        });
        break;
      }
      case "percent": {
        expParticipants.forEach((p) => {
          shares.set(p.userId, Math.floor((expAmount * p.value) / 100));
        });
        const totalAlloc = [...shares.values()].reduce((s, v) => s + v, 0);
        const diff = expAmount - totalAlloc;
        if (diff !== 0 && expParticipants.length > 0) {
          shares.set(
            expParticipants[0].userId,
            shares.get(expParticipants[0].userId)! + diff,
          );
        }
        break;
      }
      case "weight": {
        const totalWeight = expParticipants.reduce((s, p) => s + p.value, 0);
        if (totalWeight > 0) {
          expParticipants.forEach((p, idx) => {
            const share = Math.floor((expAmount * p.value) / totalWeight);
            shares.set(p.userId, share);
          });
          const totalAlloc = [...shares.values()].reduce((s, v) => s + v, 0);
          const diff = expAmount - totalAlloc;
          if (diff !== 0 && expParticipants.length > 0) {
            shares.set(
              expParticipants[0].userId,
              shares.get(expParticipants[0].userId)! + diff,
            );
          }
        }
        break;
      }
    }

    if (!balanceMap.has(payerId)) balanceMap.set(payerId, 0);
    balanceMap.set(payerId, balanceMap.get(payerId)! + expAmount);

    for (const [uid, share] of shares) {
      if (!balanceMap.has(uid)) balanceMap.set(uid, 0);
      balanceMap.set(uid, balanceMap.get(uid)! - share);
    }
  }

  // Upsert all balances in a transaction
  await prisma.$transaction(async (tx) => {
    for (const [uid, balance] of balanceMap.entries()) {
      if (!memberIds.includes(uid)) continue;
      await tx.balance.upsert({
        where: { groupId_userId: { groupId, userId: uid } },
        update: { balance },
        create: { groupId, userId: uid, balance },
      });
    }
  });
}

// ───────────────────────────── Service Functions ─────────────────────────────

export async function createExpense(
  groupId: string,
  userId: string,
  input: CreateExpenseInput,
) {
  await assertMember(groupId, userId);
  await assertGroupActive(groupId);

  await validateParticipants(
    groupId,
    input.paidByUserId,
    input.participants,
    input.amount,
    input.splitMode,
  );

  const expense = await prisma.$transaction(async (tx) => {
    const created = await tx.expense.create({
      data: {
        groupId,
        description: input.description,
        amount: input.amount,
        currency: input.currency ?? "VND",
        paidByUserId: input.paidByUserId,
        splitMode: input.splitMode,
        createdBy: userId,
        participants: {
          create: input.participants.map((p) => ({
            userId: p.userId,
            value: p.value,
          })),
        },
      },
      include: {
        participants: {
          include: { user: { select: { id: true, displayName: true } } },
        },
        payer: { select: { id: true, displayName: true } },
      },
    });
    return created;
  });

  await recalculateBalances(groupId);

  return expense;
}

export async function getExpenses(
  groupId: string,
  userId: string,
  page: number,
  limit: number,
) {
  await assertMember(groupId, userId);

  const skip = (page - 1) * limit;

  const [items, total] = await Promise.all([
    prisma.expense.findMany({
      where: { groupId },
      include: {
        participants: {
          include: { user: { select: { id: true, displayName: true } } },
        },
        payer: { select: { id: true, displayName: true } },
        creator: { select: { id: true, displayName: true } },
      },
      orderBy: { createdAt: "desc" },
      skip,
      take: limit,
    }),
    prisma.expense.count({ where: { groupId } }),
  ]);

  return {
    items,
    pagination: {
      page,
      limit,
      total,
      totalPages: Math.ceil(total / limit),
    },
  };
}

export async function getExpense(
  groupId: string,
  expenseId: string,
  userId: string,
) {
  await assertMember(groupId, userId);

  const expense = await prisma.expense.findUnique({
    where: { id: expenseId },
    include: {
      participants: {
        include: { user: { select: { id: true, displayName: true } } },
      },
      payer: { select: { id: true, displayName: true } },
      creator: { select: { id: true, displayName: true } },
    },
  });

  if (!expense || expense.groupId !== groupId) {
    throw new NotFoundError("Expense not found");
  }

  return expense;
}

export async function updateExpense(
  groupId: string,
  expenseId: string,
  userId: string,
  input: UpdateExpenseInput,
) {
  await assertMember(groupId, userId);
  await assertGroupActive(groupId);
  await assertCanModifyExpense(groupId, expenseId, userId);

  const updateData: Record<string, unknown> = {};
  if (input.description !== undefined) updateData.description = input.description;
  if (input.amount !== undefined) updateData.amount = input.amount;
  if (input.currency !== undefined) updateData.currency = input.currency;
  if (input.paidByUserId !== undefined) updateData.paidByUserId = input.paidByUserId;
  if (input.splitMode !== undefined) updateData.splitMode = input.splitMode;

  const existingExpense = await prisma.expense.findUnique({
    where: { id: expenseId },
    include: { participants: true },
  });
  if (!existingExpense) throw new NotFoundError("Expense not found");

  const effectiveAmount = input.amount ?? existingExpense.amount;
  const effectiveSplitMode = input.splitMode ?? existingExpense.splitMode;
  const effectivePaidByUserId = input.paidByUserId ?? existingExpense.paidByUserId;
  const effectiveParticipants =
    input.participants ??
    existingExpense.participants.map((p) => ({
      userId: p.userId,
      value: p.value,
    }));

  if (input.participants || input.splitMode || input.amount !== undefined || input.paidByUserId) {
    await validateParticipants(
      groupId,
      effectivePaidByUserId,
      effectiveParticipants,
      effectiveAmount,
      effectiveSplitMode,
    );
  }

  const expense = await prisma.$transaction(async (tx) => {
    if (input.participants) {
      await tx.expenseParticipant.deleteMany({ where: { expenseId } });
      await tx.expenseParticipant.createMany({
        data: input.participants!.map((p) => ({
          expenseId,
          userId: p.userId,
          value: p.value,
        })),
      });
    }

    const updated = await tx.expense.update({
      where: { id: expenseId },
      data: updateData,
      include: {
        participants: {
          include: { user: { select: { id: true, displayName: true } } },
        },
        payer: { select: { id: true, displayName: true } },
        creator: { select: { id: true, displayName: true } },
      },
    });
    return updated;
  });

  await recalculateBalances(groupId);

  return expense;
}

export async function deleteExpense(
  groupId: string,
  expenseId: string,
  userId: string,
) {
  await assertMember(groupId, userId);
  await assertGroupActive(groupId);
  await assertCanModifyExpense(groupId, expenseId, userId);

  const expense = await prisma.expense.findUnique({
    where: { id: expenseId },
  });
  if (!expense || expense.groupId !== groupId) {
    throw new NotFoundError("Expense not found");
  }

  await prisma.expense.delete({ where: { id: expenseId } });

  await recalculateBalances(groupId);

  return { id: expenseId };
}
